/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Solo /_astro/ tiene nombres de archivo con hash (los agrega Astro en el
# build) -- ahí sí es seguro cachear "para siempre": un cambio de contenido
# genera un archivo nuevo con otro hash, nunca pisa el viejo. Todo lo que
# está bajo /assets/ (CSS, JS, imágenes) se sirve con el mismo nombre en cada
# deploy, así que cachearlo así dejaría a quien vuelve al sitio viendo la
# versión vieja durante un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
