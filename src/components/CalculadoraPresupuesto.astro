  .calc__diag-filas { display: grid; gap: 10px; }
  .calc__diag-resumen {
    margin: 16px 0 0;
    padding: 12px 14px;
    background: rgba(213, 255, 60, 0.08);
    border-left: 3px solid var(--lime-500);
