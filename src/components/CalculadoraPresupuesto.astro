    color: var(--text-soft);
    cursor: pointer;
    user-select: none;
  }
  .calc__avanzado summary:hover { color: var(--lime-500); }
  .calc__avanzado-campos {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
