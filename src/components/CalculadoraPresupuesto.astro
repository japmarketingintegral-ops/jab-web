  .calc__total strong { font-family: var(--font-display); font-size: clamp(24px, 3vw, 32px); color: var(--lime-500); }

  .calc__nota { margin: 14px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-faint); }

  .calc__diagnostico { margin-top: 24px; border-top: 1px solid var(--border-dark); padding-top: 20px; }
  .calc__diagnostico[hidden] { display: none; }
  .calc__diagnostico-titulo {
    margin: 0 0 12px;
