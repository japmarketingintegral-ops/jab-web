---
// Los nueve iconos de la sección Servicios. Trazo fino, sin relleno, todos
// sobre la misma grilla de 24 para que pesen visualmente igual.
interface Props {
  nombre: string;
}
const { nombre } = Astro.props;
const A = '#3D6AF1';
---
{nombre === 'consultoria' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
    <circle cx="17.8" cy="5.6" r="2.5"/><circle cx="5.4" cy="11.6" r="2.5"/><circle cx="16.6" cy="18" r="2.5"/>
    <path d="M7.7 10.1c2.2-1.8 4.7-3.2 7.6-4M7.5 13.5c2.2 1.2 4.6 2.6 6.8 4.2"/>
  </svg>
)}
{nombre === 'digital' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3.4 11.2c0-1 .6-1.7 1.5-2l11.7-4.1c1.1-.4 2.2.4 2.2 1.6v9.6c0 1.2-1.1 2-2.2 1.6L4.9 13.9c-.9-.3-1.5-1-1.5-2z"/>
    <path d="M7.6 13.6v3.5c0 1.7 2.4 2.3 3.2.7l.9-1.9"/><path d="M21 8.8c1.1 1.3 1.1 3.5 0 4.8"/>
  </svg>
)}
{nombre === 'paid' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11.2" cy="12.8" r="8.2"/><circle cx="11.2" cy="12.8" r="3.5"/>
    <path d="M13.8 10.2c1.9-2.1 4.2-4.1 6.7-5.8"/><path d="M17.2 4c1.3-.3 2.5-.3 3.6 0 .3 1.1.3 2.4 0 3.6"/>
  </svg>
)}
{nombre === 'diseno' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3.2c5 0 8.9 3.6 8.9 8.3 0 3-2.4 4.7-5 4.7h-1.5c-1 0-1.9.8-1.9 1.9 0 .5.2.9.4 1.2.3.4.4.8.4 1.2 0 1-.8 1.7-1.9 1.7-4.7 0-8.4-4.1-8.4-9.1C3 7.1 7 3.2 12 3.2z"/>
    <circle cx="8" cy="9.6" r="1.05"/><circle cx="12" cy="7.5" r="1.05"/><circle cx="16" cy="9.9" r="1.05"/>
  </svg>
)}
{nombre === 'web' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.6" y="4.2" width="18.8" height="15.6" rx="3.6"/><path d="M2.6 8.6h18.8"/>
    <circle cx="5.7" cy="6.4" r=".75"/><circle cx="8.1" cy="6.4" r=".75"/>
    <path d="M10.2 11.6c-1.7.4-2.7 1.4-2.7 2.9s1 2.5 2.7 2.9M13.8 11.6c1.7.4 2.7 1.4 2.7 2.9s-1 2.5-2.7 2.9"/>
  </svg>
)}
{nombre === 'crm' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.8" y="4" width="5.4" height="16" rx="1.6"/>
    <rect x="9.9" y="4" width="5.4" height="11" rx="1.6"/>
    <rect x="17" y="4" width="4.2" height="6.6" rx="1.6"/>
    <path d="M19.1 14.2v5.2M16.9 17.2l2.2 2.2 2.2-2.2"/>
  </svg>
)}
{nombre === 'social' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 7.4c0-1.7 1.4-3 3.1-3h11.8c1.7 0 3.1 1.3 3.1 3v6.4c0 1.7-1.4 3-3.1 3H9.6L5.4 20.5c-.3.3-.8 0-.8-.4v-3.1C3.7 16.4 3 15.2 3 13.8z"/>
    <path d="M12 13.4c-1.5-.9-3.1-2.3-3.1-3.9 0-1.6 2-2.4 3.1-1.1 1.1-1.3 3.1-.5 3.1 1.1 0 1.6-1.6 3-3.1 3.9z"/>
  </svg>
)}
{nombre === 'audiovisual' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.6" y="5.4" width="12.4" height="10.4" rx="3.2"/><circle cx="8.8" cy="10.6" r="2.6"/>
    <path d="M15 9.6c1.5-1 3-1.9 4.2-2.5 1.1-.5 2.2.3 2.2 1.5v5c0 1.2-1.1 2-2.2 1.5-1.2-.6-2.7-1.5-4.2-2.5"/>
    <path d="M8.8 15.8c-.4 1.9-1.3 3.6-2.6 5.2M8.8 15.8c.4 1.9 1.3 3.6 2.6 5.2"/>
  </svg>
)}
{nombre === 'industrial' && (
  <svg class="servicio__icon" viewBox="0 0 24 24" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2.8 20.6V11l5.4 3.1V11l5.4 3.1V7.2l5.6 3.2v10.2z"/>
    <path d="M2.8 20.6h18.4"/>
    <path d="M16.4 4.2h2.6l.6 6.2"/>
  </svg>
)}
