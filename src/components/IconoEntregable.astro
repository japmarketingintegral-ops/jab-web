---
// Los ocho iconos de la sección "Qué incluye el sistema", tal cual venían del
// embudo original. Se agrupan acá para no llenar la página de SVG.
interface Props {
  nombre: string;
}
const { nombre } = Astro.props;
const A = '#3d6af1';
---
{nombre === 'landing' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <rect x="2" y="4" width="22" height="16" rx="2" stroke={A} stroke-width="1.6"/>
    <path d="M8 22h10" stroke={A} stroke-width="1.6" stroke-linecap="round"/>
    <circle cx="18" cy="12" r="3" stroke={A} stroke-width="1.4"/>
    <path d="M7 10l4 4" stroke={A} stroke-width="1.4" stroke-linecap="round"/>
    <path d="M7 14h4" stroke={A} stroke-width="1.4" stroke-linecap="round"/>
  </svg>
)}
{nombre === 'campanas' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <path d="M4 13h3M19 13h3M13 4v3M13 19v3" stroke={A} stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="13" cy="13" r="4" stroke={A} stroke-width="1.5"/>
    <circle cx="13" cy="13" r="8" stroke={A} stroke-width="1.3" stroke-dasharray="2 2"/>
  </svg>
)}
{nombre === 'creativos' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <rect x="3" y="3" width="9" height="9" rx="1.5" stroke={A} stroke-width="1.5"/>
    <rect x="14" y="3" width="9" height="9" rx="1.5" stroke={A} stroke-width="1.5"/>
    <rect x="3" y="14" width="9" height="9" rx="1.5" stroke={A} stroke-width="1.5"/>
    <path d="M14 18.5h9M18.5 14v9" stroke={A} stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}
{nombre === 'crm' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <rect x="3" y="5" width="20" height="4" rx="1" stroke={A} stroke-width="1.5"/>
    <rect x="3" y="11" width="20" height="4" rx="1" stroke={A} stroke-width="1.5"/>
    <rect x="3" y="17" width="20" height="4" rx="1" stroke={A} stroke-width="1.5"/>
    <circle cx="21" cy="7" r="1.2" fill={A}/>
    <circle cx="21" cy="13" r="1.2" fill={A}/>
    <circle cx="21" cy="19" r="1.2" fill="rgba(61,106,241,0.4)"/>
  </svg>
)}
{nombre === 'reportes' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <path d="M3 20h20" stroke={A} stroke-width="1.5" stroke-linecap="round"/>
    <rect x="5" y="13" width="4" height="7" rx="1" fill="rgba(61,106,241,0.25)" stroke={A} stroke-width="1.3"/>
    <rect x="11" y="9" width="4" height="11" rx="1" fill="rgba(61,106,241,0.35)" stroke={A} stroke-width="1.3"/>
    <rect x="17" y="5" width="4" height="15" rx="1" fill="rgba(61,106,241,0.5)" stroke={A} stroke-width="1.3"/>
  </svg>
)}
{nombre === 'ia' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <path d="M13 3v4M13 19v4M3 13h4M19 13h4" stroke={A} stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="13" cy="13" r="5" stroke={A} stroke-width="1.5"/>
    <path d="M10 13l2 2 4-4" stroke={A} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{nombre === 'onboarding' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <path d="M13 3l2.5 6h6.5l-5.25 3.8 2 6.2L13 15.6l-5.75 3.4 2-6.2L4 9h6.5L13 3z" stroke={A} stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
)}
{nombre === 'soporte' && (
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <path d="M5 12a8 8 0 1116 0" stroke={A} stroke-width="1.5"/>
    <rect x="3" y="12" width="3" height="6" rx="1.5" stroke={A} stroke-width="1.4"/>
    <rect x="20" y="12" width="3" height="6" rx="1.5" stroke={A} stroke-width="1.4"/>
    <path d="M22 18c0 2-2 4-4 4h-4" stroke={A} stroke-width="1.4" stroke-linecap="round"/>
    <circle cx="14" cy="22" r="1.2" fill={A}/>
  </svg>
)}
