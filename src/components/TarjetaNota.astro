---
import type { CollectionEntry } from 'astro:content';

interface Props {
  nota: CollectionEntry<'blog'>;
}

const { nota } = Astro.props;
const { titulo, bajada, categoria, fecha, lectura, portada, portadaAlt } = nota.data;

const fechaCorta = fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'short', year: 'numeric' });
---
<a class="post" href={`/blog/${nota.id}/`} data-reveal>
  <div class="post__cover">
    {portada
      ? <img src={portada} alt={portadaAlt ?? ''} loading="lazy" width="800" height="500">
      : <div class="slot">{categoria}</div>}
  </div>
  <div class="post__body">
    <p class="post__meta">
      {categoria}<span></span><span><time datetime={fecha.toISOString()}>{fechaCorta}</time></span>
    </p>
    <h3 class="post__title">{titulo}</h3>
    <p>{bajada}</p>
    <p class="post__foot">{lectura} min de lectura<span aria-hidden="true">&rarr;</span></p>
  </div>
</a>
