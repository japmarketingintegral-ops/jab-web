---
interface Props {
  /** Asunto del mail que llega. Sirve para distinguir de qué página vino. */
  asunto?: string;
}

const { asunto = 'Nueva consulta desde el sitio web' } = Astro.props;

/*
  Los mensajes se envían con Web3Forms y llegan por mail a la casilla asociada
  a la access_key. Esa clave no es secreta: viaja en el HTML, a la vista de
  cualquiera. Lo único que habilita es mandar mensajes por este formulario.
  Si algún día empieza a entrar spam, se da de baja en web3forms.com.

  Si el envío falla, el JS abre WhatsApp con el mensaje ya armado para que la
  consulta no se pierda.
*/
---
<form class="form" data-form-contacto action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="eb3719fd-f3cc-4b25-9708-021a6f4f09a9">
  <input type="hidden" name="subject" value={asunto}>
  <input type="hidden" name="from_name" value="Sitio web Jab Marketing">

  <div class="field">
    <label for="nombre">Nombre</label>
    <input id="nombre" name="nombre" type="text" required autocomplete="name" placeholder="Tu nombre">
  </div>
  <div class="field">
    <label for="empresa">Empresa</label>
    <input id="empresa" name="empresa" type="text" autocomplete="organization" placeholder="Nombre del negocio">
  </div>
  <div class="field">
    <label for="contacto">Mail o teléfono</label>
    <input id="contacto" name="contacto" type="text" required placeholder="Para poder responderte">
  </div>
  <div class="field">
    <label for="mensaje">Qué necesitás</label>
    <textarea id="mensaje" name="mensaje" rows="3" placeholder="Contanos brevemente el objetivo"></textarea>
  </div>

  <p class="hp" aria-hidden="true">
    <label for="empresa-web">No completar</label>
    <input id="empresa-web" name="empresa-web" type="text" tabindex="-1" autocomplete="off">
  </p>

  <button type="submit">Enviar mensaje</button>
  <p class="form__status" role="status" aria-live="polite"></p>
</form>
