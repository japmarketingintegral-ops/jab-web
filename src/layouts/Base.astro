---
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la imagen para redes, relativa al sitio. */
  imagen?: string;
  /** Las notas del blog se marcan como artículo para Open Graph. */
  articulo?: boolean;
}

const { titulo, descripcion, imagen = '/assets/img/og.jpg', articulo = false } = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<meta name="theme-color" content="#00002E">
<link rel="canonical" href={canonica}>

<meta property="og:type" content={articulo ? 'article' : 'website'}>
<meta property="og:locale" content="es_AR">
<meta property="og:site_name" content="Jab Marketing">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descripcion}>
<meta property="og:url" content={canonica}>
<meta property="og:image" content={imagenAbs}>
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/isotipo-blanco.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/isotipo-blanco.png">
<link rel="alternate" type="application/rss+xml" title="Blog de Jab Marketing" href="/rss.xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/styles.css">

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Jab Marketing',
  description: 'Agencia de marketing integral: consultoría, marketing digital, diseño y comunicación, desarrollo web, social media, producción audiovisual y paid media.',
  slogan: 'Strategy Matters',
  url: Astro.site?.href,
  email: 'jabmarketingintegral@gmail.com',
  telephone: '+5493402500000',
  areaServed: 'AR',
})} />
</head>
<body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>

<Nav />

<main id="contenido">
  <slot />
</main>

<Pie />

<script src="/assets/js/main.js" defer is:inline></script>
</body>
</html>
