---
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la imagen para redes, relativa al sitio. */
  imagen?: string;
  /** Las notas del blog se marcan como artículo para Open Graph. */
  articulo?: boolean;
}

const { titulo, descripcion, imagen = '/assets/img/og.jpg', articulo = false } = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);

// Único contenedor de medición del sitio. GA4 y cualquier otro píxel (Meta Ads,
// etc.) se configuran adentro de este contenedor en tagmanager.google.com, no
// acá: así se pueden sumar o sacar sin volver a tocar código.
const GTM_ID = 'GTM-K3D5RKF5';
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
<!-- Google Tag Manager: va lo más arriba posible del <head> para que nada se
     dispare antes de que el contenedor esté listo. -->
<script define:vars={{ GTM_ID }}>
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',GTM_ID);
</script>
<!-- End Google Tag Manager -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<meta name="theme-color" content="#00002E">
<link rel="canonical" href={canonica}>

<meta property="og:type" content={articulo ? 'article' : 'website'}>
<meta property="og:locale" content="es_AR">
<meta property="og:site_name" content="Jab Marketing">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descripcion}>
<meta property="og:url" content={canonica}>
<meta property="og:image" content={imagenAbs}>
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/isotipo-blanco.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/isotipo-blanco.png">
<link rel="alternate" type="application/rss+xml" title="Blog de Jab Marketing" href="/rss.xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/styles.css">

<!--
  Ficha del negocio para Google y para los modelos de IA. ProfessionalService
  es un subtipo de LocalBusiness: sin dirección ni zona de cobertura, Google no
  puede asociarte a búsquedas locales, que es de donde viene el cliente de una
  agencia regional.
-->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://jabmarketing.site/#empresa',
  name: 'Jab Marketing',
  alternateName: 'JAB Marketing Integral',
  description: 'Agencia de marketing integral en Arroyo Seco, Santa Fe. Trabaja con empresas de Arroyo Seco, Rosario y la región en consultoría, marketing digital, paid media, diseño, desarrollo web, CRM, social media y producción audiovisual.',
  slogan: 'Strategy Matters',
  url: 'https://jabmarketing.site/',
  logo: 'https://jabmarketing.site/assets/img/isologo-horizontal-blanco.svg',
  image: 'https://jabmarketing.site/assets/img/og.jpg',
  email: 'hola@jabmarketing.site',
  telephone: '+5493402415366',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Arroyo Seco',
    addressRegion: 'Santa Fe',
    addressCountry: 'AR',
  },
  areaServed: [
    { '@type': 'City', name: 'Arroyo Seco' },
    { '@type': 'City', name: 'Rosario' },
    { '@type': 'State', name: 'Santa Fe' },
    { '@type': 'Country', name: 'Argentina' },
  ],
  // Debe coincidir con el horario cargado en el Perfil de Negocio de Google.
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
  knowsLanguage: 'es-AR',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de marketing',
    itemListElement: [
      'Consultoría de marketing',
      'Marketing digital',
      'Paid media en Meta, Google y TikTok Ads',
      'Diseño y comunicación',
      'Desarrollo web',
      'CRM y automatizaciones',
      'Social media',
      'Producción audiovisual',
      'Sistemas B2B industriales',
    ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
})} />

<!-- Cada página puede sumar sus propias fichas de datos estructurados
     (migas de pan, servicio, preguntas frecuentes). -->
<slot name="cabeza" />
</head>
<body>
<!-- Google Tag Manager (noscript): cubre a quien navega sin JavaScript -->
<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<a class="skip-link" href="#contenido">Saltar al contenido</a>

<Nav />

<main id="contenido">
  <slot />
</main>

<Pie />

<script src="/assets/js/main.js" defer is:inline></script>
</body>
</html>
