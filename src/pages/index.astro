---
import Base from '../layouts/Base.astro';
import TarjetaNota from '../components/TarjetaNota.astro';
import Formulario from '../components/Formulario.astro';
import IconoServicio from '../components/IconoServicio.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { clientes } from '../datos/clientes';

// Los clientes se reparten alternados entre las dos cintas, no la primera mitad
// en una y el resto en la otra: así las marcas más conocidas quedan repartidas
// y cualquiera de las dos bandas que mires tiene algo que reconocer.
const bandas = [
  clientes.filter((_, i) => i % 2 === 0),
  clientes.filter((_, i) => i % 2 === 1),
];

// Para editar un servicio: cambiar el texto acá. El orden de la lista es el
// orden en que aparecen. Los iconos viven en components/IconoServicio.astro.
const servicios = [
  { ico: 'consultoria', titulo: 'Consultoría',
    texto: 'Analizamos datos internos y de mercado para fundamentar la toma de decisiones. Definimos el posicionamiento de la marca mediante un enfoque integral y sostenible a largo plazo, garantizando coherencia en cada acción.' },
  { ico: 'digital', titulo: 'Marketing digital',
    texto: 'Ejecutamos estrategias digitales guiadas por la medición y el análisis de datos. Realizamos un seguimiento constante de las métricas clave en cada canal para saber qué funciona, respaldando cada decisión con información concreta.' },
  { ico: 'paid', titulo: 'Paid media',
    texto: 'Gestionamos campañas publicitarias en Meta, Google y TikTok Ads. Optimizamos la inversión seleccionando los canales y formatos adecuados para alcanzar los objetivos comerciales.' },
  { ico: 'diseno', titulo: 'Diseño y comunicación',
    texto: 'Construimos marcas con un lenguaje visual sólido y adaptable a múltiples plataformas. Diseñamos piezas de comunicación enfocadas en transmitir los valores de la marca y consolidar su posicionamiento en el mercado.' },
  { ico: 'web', titulo: 'Desarrollo web',
    texto: 'Diseñamos y programamos sitios web y landing pages a medida. Cada desarrollo se estructura para optimizar la experiencia del usuario, cumplir una función específica y acompañar el ciclo de venta del negocio.' },
  { ico: 'crm', titulo: 'CRM y automatizaciones',
    texto: 'Optimizamos la gestión mediante la implementación de CRM (partners oficiales de Kommo). Diseñamos automatizaciones a medida para ordenar los procesos comerciales y agilizar la calificación y el seguimiento de contactos.' },
  { ico: 'social', titulo: 'Social media',
    texto: 'Diseñamos estrategias de contenido alineadas con la etapa en la que se encuentra el negocio. Desarrollamos calendarios editoriales para fortalecer la autoridad de la marca y conectar de forma genuina con su audiencia.' },
  { ico: 'audiovisual', titulo: 'Producción audiovisual',
    texto: 'Ejecutamos producciones de alto nivel, incluyendo tomas con drone y cobertura de eventos. Desarrollamos desde videos para redes hasta spots publicitarios para pauta digital o presentaciones institucionales.' },
  // El único que además es enlace: lleva a la landing del servicio.
  { ico: 'industrial', titulo: 'Sistemas B2B industriales', enlace: '/industrial/',
    texto: 'Implementamos sistemas de captación diseñados exclusivamente para el ciclo de venta B2B industrial. Generamos consultas calificadas de forma recurrente para escalar el crecimiento comercial sin depender de referidos.' },
];

// Las cuatro etapas del ciclo. Se usan dos veces —anillo en desktop, línea de
// tiempo en mobile— así que viven acá y no duplicadas en el HTML.
const etapas = [
  { n: '01', titulo: 'Entendemos el negocio', texto: 'Márgenes, objetivos, competencia y a quién le vendés. Sin esto, cualquier campaña es una apuesta.' },
  { n: '02', titulo: 'Detectamos oportunidades', texto: 'Dónde está el crecimiento posible: qué canal rinde, qué mensaje falta y qué se está dejando pasar.' },
  { n: '03', titulo: 'Ejecutamos con criterio', texto: 'Publicamos, pauteamos y hacemos seguimiento. Cada decisión respaldada por lo que dicen los datos.' },
  { n: '04', titulo: 'Analizamos y escalamos', texto: 'Lo que funciona se profundiza, lo que no se corrige. Y vuelve a alimentar la etapa 01.' },
];

const notas = (await getCollection('blog', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---

<Base
  titulo="Agencia de marketing en Rosario y Arroyo Seco | Jab Marketing"
  descripcion="Agencia de marketing integral en Arroyo Seco y Rosario. Estrategia, pauta en Meta y Google, diseño, desarrollo web y contenido para empresas de Santa Fe."
>


  <!-- ==================== HERO ==================== -->
  <section class="hero" id="top">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">[ MARKETING ]</p>
      <h1 class="hero__title">El marketing empieza<br>por <strong>entender el negocio.</strong></h1>
      <p class="hero__lead">Diseñamos sistemas de marketing que entienden cómo funciona tu negocio y trabajan para hacerlo crecer.</p>
      <p class="hero__propuesta"><span>Nos enfocamos en lo importante:</span>Pensar, ejecutar y <strong>generar resultados.</strong></p>
      <div class="hero__actions">
        <a class="btn btn--cta"
           href="https://wa.me/5493402415366?text=Hola%20Jab%2C%20quiero%20hablar%20de%20mi%20negocio"
           target="_blank" rel="noopener">
          Hablemos por WhatsApp <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn--ghost" href="#servicios">Ver qué hacemos</a>
      </div>
      <p class="rule-label">Strategy Matters</p>
    </div>
    <!--
      El render viene con fondo negro, sin transparencia. El mix-blend-mode:screen
      del CSS es lo que lo funde con el navy: no reemplazar por una versión
      recortada ni cambiar el fondo de la sección sin revisar ese efecto.
    -->
    <!-- Tres capas para animar por separado: entrada, flotación y giro -->
    <div class="hero__art">
      <div class="hero__art-orbita">
        <img src="/assets/img/isotipo-3d.webp" alt="" width="1037" height="1080" fetchpriority="high">
      </div>
    </div>
  </section>

  <!-- ==================== SERVICIOS ==================== -->
  <section id="servicios">
    <div class="servicios__head">
      <h2 class="section-title" data-reveal>Servicios</h2>
    </div>

    <!--
      El servicio con landing propia es una tarjeta más en desktop, pero en
      mobile ocupa el ancho completo y se lee como franja aparte. Es un solo
      elemento: el cambio es puro CSS, no hay contenido duplicado.
    -->
    <div class="servicios__grid">
      {servicios.map((s) => {
        const Caja = s.enlace ? 'a' : 'article';
        return (
          <Caja class={`servicio${s.enlace ? ' servicio--vertical' : ''}`} href={s.enlace} data-reveal>
            <IconoServicio nombre={s.ico} />
            <div>
              {s.enlace && <p class="servicio__rotulo">Vertical</p>}
              <h3 class="servicio__title">{s.titulo}</h3>
              <p>{s.texto}</p>
              {s.enlace && (
                <span class="servicio__cta">Ver el sistema <span aria-hidden="true">&rarr;</span></span>
              )}
            </div>
          </Caja>
        );
      })}
    </div>
  </section>

  <!-- ==================== METODOLOGÍA ==================== -->
  <section class="metodo" id="metodo">
    <div class="wrap">

      <div class="metodo__head" data-reveal>
        <p class="eyebrow">[ CÓMO TRABAJAMOS ]</p>
        <h2 class="metodo__title">Metodología</h2>
        <p class="metodo__lead">Cuatro etapas que no terminan: cada ciclo vuelve a empezar con más información que el anterior.</p>
      </div>

      <!--
        Anillo en desktop, línea de tiempo en mobile. Las dos versiones marcan
        la etapa activa y hacen crecer al cliente con cada vuelta cumplida.
        Solo las piezas decorativas llevan aria-hidden: el texto de las etapas
        tiene que seguir siendo legible para un lector de pantalla.
      -->
      <div class="loop" data-loop>
        <div class="loop__ring" aria-hidden="true"></div>
        <div class="loop__core" aria-hidden="true">
          <img class="loop__isotipo" src="/assets/img/isotipo-blanco.svg" alt="" width="454" height="454">
        </div>
        <div class="loop__marcador" aria-hidden="true" data-loop-marcador>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8.2" r="3.3"/>
            <path d="M4.8 20c0-3.9 3.2-7 7.2-7s7.2 3.1 7.2 7"/>
          </svg>
        </div>
        <div class="loop__tick loop__tick--1" aria-hidden="true">&#9650;</div>
        <div class="loop__tick loop__tick--2" aria-hidden="true">&#9650;</div>
        <div class="loop__tick loop__tick--3" aria-hidden="true">&#9650;</div>
        <div class="loop__tick loop__tick--4" aria-hidden="true">&#9650;</div>

        {etapas.map((e, i) => (
          <div class={`paso paso--${i + 1}`} data-reveal>
            <p class="paso__num">{e.n} &mdash;</p>
            <h3 class="paso__title">{e.titulo}</h3>
            <p>{e.texto}</p>
          </div>
        ))}
      </div>

      <div class="timeline" data-loop-mobile>
        <div class="timeline__marcador" aria-hidden="true" data-loop-marcador>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8.2" r="3.3"/>
            <path d="M4.8 20c0-3.9 3.2-7 7.2-7s7.2 3.1 7.2 7"/>
          </svg>
        </div>
        {etapas.map((e) => (
          <div class="paso">
            <p class="paso__num">{e.n} &mdash;</p>
            <h3 class="paso__title">{e.titulo}</h3>
            <p>{e.texto}</p>
          </div>
        ))}
        <p class="timeline__loopback"><span aria-hidden="true">&#8634;</span> Vuelve a 01</p>
      </div>

      <div class="equipo" data-reveal>
        <div>
          <h3 class="equipo__title">Un equipo detrás de cada cuenta</h3>
          <p>Cada cuenta tiene un responsable que coordina y especialistas que ejecutan —diseño, contenido, pauta— todo bajo una misma estrategia.</p>
        </div>
        <ul class="equipo__list">
          <li>Conocimiento real del negocio de cada cliente</li>
          <li>Decisiones anticipadas, no reactivas</li>
          <li>Mejora continua con cada entrega</li>
          <li>Reportes claros de en qué se invierte el tiempo</li>
        </ul>
      </div>

    </div>
  </section>

    <!-- ==================== BLOG ==================== -->
  <section class="blog" id="blog">
    <div class="wrap">

      <div class="blog__head" data-reveal>
        <p class="pill">Blog</p>
        <h2 class="blog__title">Lo último que <strong>publicamos</strong></h2>
        <p class="blog__lead">Estrategias, análisis y aprendizajes de cuentas reales, para que tomes mejores decisiones.</p>
      </div>

      {notas.length > 0 ? (
        <>
          <!--
            Carrusel: avanza solo, vuelve al principio al llegar al final y se
            frena apenas alguien lo toca o pasa el mouse. Sin JS queda un
            deslizable normal, que es como funciona en el celular igual.
          -->
          <div class="carrusel" data-carrusel>
            <div class="carrusel__pista">
              {notas.map((nota) => <TarjetaNota nota={nota} />)}
            </div>

            <button class="carrusel__flecha carrusel__flecha--antes" type="button" data-carrusel-antes aria-label="Nota anterior">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="carrusel__flecha carrusel__flecha--luego" type="button" data-carrusel-luego aria-label="Nota siguiente">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>

          <div class="blog__more" data-reveal>
            <a class="btn btn--ghost btn--sm" href="/blog/">Ver todas las notas</a>
          </div>
        </>
      ) : (
        <p class="blog__lead" style="text-align:center">Estamos preparando las primeras notas.</p>
      )}

    </div>
  </section>

  <!-- ==================== CLIENTES ==================== -->
  <section class="clientes" id="clientes">
    <div class="wrap">
      <div class="clientes__head" data-reveal>
        <h2 class="section-title">Clientes</h2>
        <p class="clientes__lead">
          Marcas que trabajan su marketing con nosotros. Industria, comercio, salud,
          agro y sector público, desde Arroyo&nbsp;Seco y Rosario hacia todo el país.
        </p>
      </div>
    </div>

    <!-- Dos cintas que corren en sentidos opuestos. Cada lista va dos veces: el
         desfile se corta a la mitad y vuelve a empezar sin salto visible. La
         copia lleva alt vacío para que no se lean los nombres dos veces. -->
    <div class="cinta-clientes">
      {bandas.map((banda, n) => (
        <div class={`cinta-clientes__banda${n === 1 ? ' cinta-clientes__banda--vuelve' : ''}`}>
          <div class="cinta-clientes__pista" style={`--desfile:${(banda.length * 3.8).toFixed(1)}s`}>
            {banda.map((c) => (
              <div class="cinta-clientes__marca">
                <Image src={c.logo} alt={c.nombre} width={300} loading="lazy" />
              </div>
            ))}
            {banda.map((c) => (
              <div class="cinta-clientes__marca cinta-clientes__marca--eco" aria-hidden="true">
                <Image src={c.logo} alt="" width={300} loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== CONTACTO ==================== -->
  <section class="contacto" id="contacto">
    <div class="contacto__grid">

      <div>
        <p class="eyebrow">[ CONTACTO ]</p>
        <h2 class="contacto__title">Contanos en qué estás.<br><strong>Vemos cómo ayudarte.</strong></h2>
        <p class="contacto__lead">Respondemos todas las consultas, incluso las que todavía no son un proyecto. Si podemos darte una mano, te lo decimos; si no, también.</p>
        <a class="btn btn--cta"
           href="https://wa.me/5493402415366?text=Hola%20Jab%2C%20quiero%20hablar%20de%20mi%20negocio"
           target="_blank" rel="noopener">
          Escribinos por WhatsApp <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>

        <div class="datos">
          <div class="dato">
            <p class="dato__label">Teléfono</p>
            <p class="dato__value">+54 9 3402 41-5366</p>
          </div>
          <div class="dato">
            <p class="dato__label">Mail</p>
            <a href="mailto:jabmarketingintegral@gmail.com">jabmarketingintegral@gmail.com</a>
          </div>
        </div>
      </div>

      <Formulario />

    </div>
  </section>


</Base>
