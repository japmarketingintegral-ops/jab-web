---
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';

// Rescatado del embudo que vivía en GoHighLevel. El video sigue en YouTube.
const VIDEO = '5HgtZd_8Y7w';
const WHATSAPP = 'https://wa.me/5493402415366?text=Hola%20Jab%2C%20quiero%20el%20diagn%C3%B3stico%20para%20mi%20empresa%20industrial';

const clientes = [
  { nombre: 'Gimetal', archivo: 'gimetal' },
  { nombre: 'Geronzi', archivo: 'geronzi' },
  { nombre: 'PackGroup', archivo: 'packgroup' },
  { nombre: 'Montenegro', archivo: 'montenegro' },
  { nombre: 'Termoplast', archivo: 'termoplast' },
];

const numeros = [
  { valor: '+50', texto: 'Consultas calificadas por mes para empresas industriales B2B' },
  { valor: '4', texto: 'Etapas: diagnóstico, posicionamiento, captación y conversión' },
  { valor: '0', texto: 'Dependencia de referidos, vendedores únicos o contactos de siempre' },
];

const etapas = [
  {
    n: '01', rotulo: 'Diagnóstico', titulo: 'Auditoría de posicionamiento',
    texto: 'Analizamos tu empresa, tu mercado y tu competencia para entender dónde estás parado y cuál es la oportunidad real.',
    puntos: [
      'Análisis de presencia digital y puntos de contacto',
      'Mapeo de competidores y diferenciadores reales',
      'Identificación del cliente industrial ideal (ICP)',
      'Diagnóstico de canales con mayor retorno',
    ],
  },
  {
    n: '02', rotulo: 'Estrategia', titulo: 'Posicionamiento industrial',
    texto: 'Definimos el mensaje diferenciador de tu empresa y construimos la identidad de marca que genera confianza B2B.',
    puntos: [
      'Propuesta de valor clara y diferenciada',
      'Arquitectura de mensajes para cada canal',
      'Landing de conversión optimizada para consultas',
      'Creativos y contenido editorial industrial',
    ],
  },
  {
    n: '03', rotulo: 'Captación', titulo: 'Generación de demanda calificada',
    texto: 'Activamos campañas y canales para atraer empresas industriales que realmente necesitan lo que vos ofrecés.',
    puntos: [
      'Campañas pagas en Meta y Google segmentadas por sector',
      'Outreach en LinkedIn hacia decisores industriales',
      'Secuencias de email y WhatsApp para nurturing',
      'Optimización continua basada en datos reales',
    ],
  },
  {
    n: '04', rotulo: 'Conversión', titulo: 'Orden comercial',
    texto: 'Implementamos el CRM y los procesos para que tu equipo convierta más consultas en clientes sin perder oportunidades.',
    puntos: [
      'CRM configurado con pipeline de venta industrial',
      'Automatizaciones de seguimiento y calificación',
      'Reportes semanales con métricas que importan',
      'Soporte continuo del equipo JAB',
    ],
  },
];

const entregables = [
  { n: '01', titulo: 'Landing de conversión', texto: 'Página diseñada para captar consultas calificadas de empresas B2B industriales.' },
  { n: '02', titulo: 'Campañas pagas', texto: 'Meta y Google Ads segmentados para tu sector y decisores industriales.' },
  { n: '03', titulo: 'Creativos editoriales', texto: 'Placas, copys y piezas visuales con identidad industrial para redes y ads.' },
  { n: '04', titulo: 'CRM configurado', texto: 'Pipeline de venta industrial listo para usar desde el primer día del sistema.' },
  { n: '05', titulo: 'Reportes semanales', texto: 'Métricas que importan: consultas generadas, costo por lead y proyección mensual.' },
  { n: '06', titulo: 'Automatizaciones con IA', texto: 'Flujos de WhatsApp, email y seguimiento para que ninguna consulta quede sin respuesta.' },
  { n: '07', titulo: 'Onboarding dedicado', texto: 'Sesión de arranque con tu equipo para alinear proceso, herramientas y expectativas.' },
  { n: '08', titulo: 'Soporte continuo', texto: 'Acompañamiento mensual del equipo JAB con revisión de resultados y ajustes estratégicos.' },
];

const faq = [
  {
    p: '¿Funciona si mi empresa depende solo de referidos?',
    r: 'Sí, y justamente para eso está pensado el sistema. Los referidos son un canal valioso pero impredecible. Lo que hacemos es construir un segundo canal de consultas —controlado, escalable y medible— para que tu crecimiento no dependa de que alguien te recomiende.',
  },
  {
    p: 'Ya intenté hacer marketing antes y no funcionó. ¿Por qué sería distinto?',
    r: 'El marketing genérico no funciona en B2B industrial. El error más común es replicar lo que hace una empresa de consumo masivo. Nuestro sistema está diseñado para ciclos de venta largos, decisiones técnicas y compras institucionales. Empezamos siempre con un diagnóstico real antes de activar cualquier canal.',
  },
  {
    p: '¿Necesito tener un equipo comercial armado para empezar?',
    r: 'No. Trabajamos con equipos de todos los tamaños, incluso con el dueño como único vendedor. Parte del trabajo es estructurar el proceso comercial básico para que puedas aprovechar las consultas que genere el sistema.',
  },
  {
    p: '¿Con qué tipo de empresas industriales trabajan?',
    r: 'Trabajamos con empresas industriales de distintos sectores: agroindustria, metalúrgicas, plásticos y packaging, construcción industrial, logística, fabricantes de maquinaria, frigoríficos, química industrial y proveedores de servicios técnicos B2B, entre otros. Si tu empresa vende a otras empresas dentro del sector industrial, el sistema está pensado para vos.',
  },
];
---

<Base
  titulo="Sistema B2B Industrial — Jab Marketing"
  descripcion="El sistema que genera consultas calificadas por mes a empresas industriales, sin depender de referidos ni de un solo vendedor."
>
  <!-- ==================== HERO ==================== -->
  <section class="ind-hero" id="top">
    <div class="wrap ind-hero__grid">
      <div>
        <p class="eyebrow">[ SISTEMA B2B INDUSTRIAL ]</p>
        <h1 class="ind-hero__titulo">
          El sistema que genera<br>
          <strong>+50 consultas calificadas</strong><br>
          por mes a empresas industriales.
        </h1>
        <p class="ind-hero__lead">Diseñamos el sistema JAB, pensado para que empresas industriales puedan vender más sin depender de referidos, de los mismos contactos de siempre o de un solo vendedor.</p>
        <div class="hero__actions">
          <a class="btn btn--cta" href={WHATSAPP} target="_blank" rel="noopener">
            Diagnóstico gratuito <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href="#sistema">Ver cómo funciona</a>
        </div>
        <p class="rule-label">Marketing industrial &middot; B2B &middot; Argentina</p>
      </div>

      <!--
        El video se carga recién al hacer clic: si se incrustara de entrada,
        YouTube trae medio megabyte de scripts que casi nadie va a usar.
      -->
      <div class="ind-video" data-video={VIDEO}>
        <button class="ind-video__boton" type="button" aria-label="Reproducir el video: cómo funciona el sistema, 3 minutos">
          <img src={`https://img.youtube.com/vi/${VIDEO}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="lazy">
          <span class="ind-video__play" aria-hidden="true">&#9654;</span>
          <span class="ind-video__rotulo">3 minutos &middot; Mirá cómo funciona</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ==================== NÚMEROS ==================== -->
  <section class="ind-numeros">
    <div class="wrap ind-numeros__grid">
      {numeros.map((n) => (
        <div class="ind-numero" data-reveal>
          <p class="ind-numero__valor">{n.valor}</p>
          <p class="ind-numero__texto">{n.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== CLIENTES ==================== -->
  <section class="clientes">
    <div class="wrap">
      <p class="ind-rotulo">Empresas que ya implementaron el sistema</p>
      <div class="clientes__grid">
        {clientes.map((c) => (
          <div class="cliente" data-reveal>
            <img src={`/assets/img/clientes/${c.archivo}.png`} alt={c.nombre} loading="lazy" width="600" height="200">
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== LAS 4 ETAPAS ==================== -->
  <section class="ind-seccion" id="sistema">
    <div class="wrap">
      <div class="ind-cabecera" data-reveal>
        <p class="eyebrow">[ CÓMO FUNCIONA ]</p>
        <h2 class="ind-titulo">El sistema en <strong>4 etapas</strong></h2>
        <p class="ind-lead">Un proceso probado para empresas industriales B2B que quieren generar consultas calificadas de forma predecible y escalable, sin depender de la suerte ni de un vendedor estrella.</p>
      </div>

      <div class="ind-etapas">
        {etapas.map((e) => (
          <article class="ind-etapa" data-reveal>
            <p class="ind-etapa__n">{e.n} &mdash; <span>{e.rotulo}</span></p>
            <h3 class="ind-etapa__titulo">{e.titulo}</h3>
            <p class="ind-etapa__texto">{e.texto}</p>
            <ul class="ind-lista">
              {e.puntos.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== ENTREGABLES ==================== -->
  <section class="ind-seccion ind-seccion--azul">
    <div class="wrap">
      <div class="ind-cabecera" data-reveal>
        <p class="eyebrow" style="color:var(--celeste-100)">[ QUÉ INCLUYE EL SISTEMA ]</p>
        <h2 class="ind-titulo">Todo lo que necesitás<br><strong>para vender más.</strong></h2>
        <p class="ind-lead">No vendemos horas de consultoría. Entregamos un sistema completo, funcional y medible desde el primer mes. Cada entregable está pensado para el ciclo de venta B2B industrial. No para e-commerce. No para consumo masivo.</p>
      </div>

      <div class="ind-entregables">
        {entregables.map((e) => (
          <article class="ind-entregable" data-reveal>
            <p class="ind-entregable__n">{e.n}</p>
            <h3 class="ind-entregable__titulo">{e.titulo}</h3>
            <p>{e.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== DIAGNÓSTICO ==================== -->
  <section class="ind-seccion">
    <div class="wrap ind-diagnostico" data-reveal>
      <div>
        <p class="eyebrow">[ DIAGNÓSTICO GRATUITO ]</p>
        <h2 class="ind-titulo">El primer paso es una<br><strong>charla de 30 minutos.</strong></h2>
        <p class="ind-lead">Nos contás dónde está parada tu empresa hoy y qué querés lograr. Nosotros te mostramos si el sistema tiene sentido para vos y cómo lo haríamos.</p>
        <ul class="ind-lista">
          <li>Sin compromiso ni presión</li>
          <li>30 minutos, por videollamada</li>
          <li>Solo empresas B2B industriales</li>
        </ul>
        <a class="btn btn--cta" href={WHATSAPP} target="_blank" rel="noopener" style="margin-top:clamp(24px,4vh,36px)">
          Pedir el diagnóstico <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="ind-nota">Cupos limitados por mes. Solo trabajamos con empresas donde hay potencial real de resultado.</p>
      </div>
      <Formulario asunto="Diagnóstico — empresa industrial" />
    </div>
  </section>

  <!-- ==================== PREGUNTAS FRECUENTES ==================== -->
  <section class="ind-seccion ind-seccion--faq">
    <div class="wrap">
      <div class="ind-cabecera" data-reveal>
        <p class="eyebrow">[ PREGUNTAS FRECUENTES ]</p>
        <h2 class="ind-titulo">Lo que nos pregunta cada<br><strong>empresa antes de empezar.</strong></h2>
      </div>
      <div class="ind-faq">
        {faq.map((f) => (
          <details class="ind-faq__item" data-reveal>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.p,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
})} />
