---
// Página temporal para comparar variantes del hero. No va al sitio público:
// lleva noindex y se borra cuando esté elegida la versión.
const WHATSAPP = 'https://wa.me/5493402415366?text=Hola';

const variantes = [
  {
    id: 'actual',
    nombre: 'Cómo está hoy',
    nota: 'La pieza centrada en su columna, con aire alrededor. Se lee como una foto puesta al costado, y el hueco negro queda a media altura.',
  },
  {
    id: 'a',
    nombre: 'A — Sangrado',
    nota: 'Más grande, saliéndose del borde derecho, con un velo que protege el texto. Gana escala sin cambiar la estructura.',
  },
  {
    id: 'a2',
    nombre: 'A2 — Sangrado con acercamiento  ⭐ mi recomendación',
    nota: 'Más cerca y levemente rotada: se ve el material, los brillos y el volumen en vez de la silueta. La pieza pasa a ser textura de marca.',
  },
  {
    id: 'b',
    nombre: 'B — Centrada atmosférica',
    nota: 'Todo al centro, la pieza detrás. La tipografía se luce más, pero el hero se vuelve declaración de marca antes que página que vende.',
  },
  {
    id: 'c',
    nombre: 'C — El texto atraviesa la pieza',
    nota: 'La más dramática. Ojo con la bajada: queda sobre la zona más brillante y cuesta leerla.',
  },
];
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Variantes del hero — Jab Marketing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/styles.css">
<style>
  body { background: #05051f; }
  .rotulo {
    position: sticky; top: 0; z-index: 30;
    padding: 14px clamp(20px, 4vw, 64px);
    background: #0a0a2e;
    border-bottom: 1px solid rgba(224,244,251,.14);
  }
  .rotulo h2 {
    margin: 0; font-family: 'Funnel Display', sans-serif; font-weight: 700;
    font-size: 17px; color: #d5ff3c;
  }
  .rotulo p {
    margin: 6px 0 0; max-width: 78ch; font-size: 13.5px; line-height: 1.5;
    color: rgba(224,244,251,.62);
  }
  .marco { border-bottom: 3px solid #05051f; }

  /* La animación de entrada termina en transform:none y pisaría el
     posicionamiento de cada variante. */
  .marco .hero__art { animation: none !important; opacity: 1 !important; }
  .marco .hero__copy > * { animation: none !important; opacity: 1 !important; }
  .marco .hero { min-height: 88svh; }

  /* --- A --- */
  #a .hero { position: relative; grid-template-columns: 1fr; overflow: hidden; }
  #a .hero__copy { position: relative; z-index: 2; max-width: 620px; }
  #a .hero__art { position: absolute; right: -14%; top: 50%; transform: translateY(-50%) !important;
    width: 68vw; max-width: 1020px; min-height: 0; z-index: 0; }
  #a .hero__art-orbita { max-width: none; width: 100%; }
  #a .hero::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(100deg, #00002e 34%, rgba(0,0,46,.55) 52%, transparent 70%); }

  /* --- A2 --- */
  #a2 .hero { position: relative; grid-template-columns: 1fr; overflow: hidden; }
  #a2 .hero__copy { position: relative; z-index: 2; max-width: 620px; }
  #a2 .hero__art { position: absolute; right: -30%; top: 50%; transform: translateY(-50%) rotate(-8deg) !important;
    width: 96vw; max-width: 1500px; min-height: 0; z-index: 0; }
  #a2 .hero__art-orbita { max-width: none; width: 100%; }
  #a2 .hero::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(100deg, #00002e 32%, rgba(0,0,46,.6) 50%, transparent 72%); }

  /* --- B --- */
  #b .hero { position: relative; grid-template-columns: 1fr; place-items: center; text-align: center; overflow: hidden; }
  #b .hero__copy { position: relative; z-index: 2; max-width: 820px; }
  #b .hero__title { font-size: clamp(42px, 5.6vw, 88px); }
  #b .hero__lead, #b .hero__propuesta { margin-inline: auto; }
  #b .hero__actions, #b .rule-label { justify-content: center; }
  #b .hero__art { position: absolute; left: 50%; top: 46%; transform: translate(-50%,-50%) !important;
    width: 78vw; max-width: 1150px; min-height: 0; z-index: 0; opacity: .5; }
  #b .hero__art-orbita { max-width: none; width: 100%; }

  /* --- C --- */
  #c .hero { position: relative; grid-template-columns: 1fr; place-items: center; text-align: center; overflow: hidden; }
  #c .hero__copy { position: relative; z-index: 2; max-width: 900px; }
  #c .hero__title { font-size: clamp(42px, 6vw, 92px); }
  #c .hero__lead, #c .hero__propuesta { margin-inline: auto; }
  #c .hero__actions, #c .rule-label { justify-content: center; }
  #c .hero__art { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%) !important;
    width: min(64vh, 660px); min-height: 0; z-index: 0; opacity: .55; }
  #c .hero__art-orbita { max-width: none; width: 100%; }
</style>
</head>
<body>
{variantes.map((v) => (
  <section class="marco" id={v.id}>
    <div class="rotulo">
      <h2>{v.nombre}</h2>
      <p>{v.nota}</p>
    </div>
    <section class="hero">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">[ MARKETING ]</p>
        <h1 class="hero__title">El marketing empieza<br>por <strong>entender el negocio.</strong></h1>
        <p class="hero__lead">Diseñamos sistemas de marketing que entienden cómo funciona tu negocio y trabajan para hacerlo crecer.</p>
        <p class="hero__propuesta"><span>Nos enfocamos en lo importante:</span>Pensar, ejecutar y <strong>generar resultados.</strong></p>
        <div class="hero__actions">
          <a class="btn btn--cta" href={WHATSAPP}>Hablemos por WhatsApp <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
          <a class="btn btn--ghost" href="#">Ver qué hacemos</a>
        </div>
        <p class="rule-label">Strategy Matters</p>
      </div>
      <div class="hero__art">
        <div class="hero__art-orbita">
          <img src="/assets/img/isotipo-3d.webp" alt="" width="1037" height="1080">
        </div>
      </div>
    </section>
  </section>
))}
</body>
</html>
